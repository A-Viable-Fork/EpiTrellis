#!/usr/bin/env python3
"""What travels between parties: referent hashes, no payload.

The multi-homing argument made measurable. Copyright forces identity and
payload apart, so what crosses is kilobytes. At that size publishing to five
hosts costs nothing, and no gradient pulls anyone toward a single one. If
payload ever rides along, the gradient returns and concentration follows.

Two behaviours match `probe.py bundle`, because a function and the instrument
disagreeing about one journal is worse than either being wrong alone.

A finding with no `object_hash` is hashed at read time from a URL its reference
row already carries, since `object_hash` is `sha256(referent_key(url))[:16]`, a
pure function of that URL. Journals written before the hashing code therefore
join against another party's bundle. Nothing is appended and no row is changed.

Findings that cannot be hashed are counted and reported rather than dropped in
silence. A file share has a reference row carrying no address; a no_reference
capture has no reference row at all. Neither has an identifier and neither may
be given one.

The normalization below is a copy of the probe's, and it has to stay a copy: a
function cannot import from the instrument, and if the two ever disagree the
hashes stop joining without anything failing loudly."""
import hashlib
import json
import re
import sys
import urllib.parse

NOISE_PARAMS = {
    "utm_source", "utm_medium", "utm_campaign", "utm_term", "utm_content",
    "utm_id", "utm_name", "utm_reader", "utm_brand", "utm_social",
    "fbclid", "gclid", "dclid", "gbraid", "wbraid", "msclkid", "twclid",
    "igshid", "igsh", "ttclid", "yclid", "mc_cid", "mc_eid",
    "ref", "ref_src", "ref_url", "referrer", "source",
    "si", "is", "feature", "app", "pp", "pli", "usp",
    "s", "t", "cmpid", "smid", "spref", "share_id", "sh",
    "_branch_match_id", "_bhlid", "rdt", "cvid", "ocid",
}


def referent_key(url):
    try:
        u = urllib.parse.urlsplit(url)
    except ValueError:
        return url
    host = (u.netloc or "").lower()
    if host.startswith("www."):
        host = host[4:]
    if host.startswith("m.") or host.startswith("mobile."):
        host = host.split(".", 1)[1]
    host = re.sub(r":(80|443)$", "", host)
    path = u.path.rstrip("/") or "/"
    q = urllib.parse.urlencode(
        sorted((k, v) for k, v in urllib.parse.parse_qsl(u.query, keep_blank_values=True)
               if k.lower() not in NOISE_PARAMS))
    return urllib.parse.urlunsplit(("https", host, path, q, ""))


def refhash(url):
    return hashlib.sha256(referent_key(url).encode()).hexdigest()[:16]


# One pair, not a compatibility matrix. These two disagree about whether the
# payload was obtained, which has one answer per encounter. Multiplicity is not
# contradiction, so nothing else is counted as conflicting.
CONFLICT_PAIR = frozenset({"stable_referent", "producer_refused"})
CONFLICT_RULE = "stable_referent with producer_refused"


def derive_referent(ref):
    """Recover (referent_key, object_hash) from a reference row that predates
    the hashing code. Returns (None, None) when it carries no URL."""
    if not ref:
        return None, None
    key = ref.get("referent_key")
    if key:
        return key, hashlib.sha256(key.encode()).hexdigest()[:16]
    url = ref.get("final_url") or ref.get("cleaned_url") or ref.get("shared_url")
    if not url:
        return None, None
    return referent_key(url), refhash(url)


rows = []
for line in sys.stdin:
    line = line.strip()
    if line:
        try:
            rows.append(json.loads(line))
        except Exception:
            pass

refs = {r.get("capture_id"): r for r in rows if r.get("event") == "reference"}
objs = {}
derived_rows, derived_hashes = 0, set()
hashed_rows, findings_total = 0, 0
excluded = {"no_reference_row": 0, "no_address": 0}

for r in rows:
    if r.get("event") != "finding":
        continue
    findings_total += 1
    ref = refs.get(r.get("capture_id"))
    h = r.get("object_hash")
    key = ref.get("referent_key") if ref else None
    if not h or not key:
        dk, dh = derive_referent(ref)
        key = key or dk
        if not h and dh:
            h = dh
            derived_rows += 1
            derived_hashes.add(h)
    if not h:
        excluded["no_reference_row" if ref is None else "no_address"] += 1
        continue
    hashed_rows += 1
    e = objs.setdefault(h, {"h": h, "ref": key, "alt": {}, "kinds": [],
                            "n": 0, "srcs": set()})
    if not e["ref"]:
        e["ref"] = key
    e["n"] += 1
    # The address as recorded, before normalization. Two sightings of one
    # object are a different result depending on whether the addresses were
    # identical or merely equivalent, and the key alone cannot say which.
    if ref:
        src = (ref.get("final_url") or ref.get("cleaned_url")
               or ref.get("shared_url"))
        if src:
            e["srcs"].add(src)
    kind = r.get("kind", "unknown")
    if kind not in e["kinds"]:
        e["kinds"].append(kind)
    for v in (r.get("alt_referents") or {}).values():
        e["alt"][v["hash"]] = v["url"]

# A verdict describes an encounter, not an object. A stranger receiving this
# bundle cannot otherwise see that an object's verdict list disagrees with
# itself. Reported, not resolved.
multi_kind = sum(1 for o in objs.values() if len(o["kinds"]) > 1)
conflicting = sum(1 for o in objs.values() if CONFLICT_PAIR <= set(o["kinds"]))

out = {"v": 0, "objects": [
    {"h": o["h"], "ref": o["ref"], "seen": o["n"], "kinds": o["kinds"], "alt": o["alt"]}
    for o in sorted(objs.values(), key=lambda x: x["ref"] or "")],
    "findings": findings_total,
    "excluded": {"no_address": excluded["no_address"],
                 "no_reference_row": excluded["no_reference_row"],
                 "total": excluded["no_address"] + excluded["no_reference_row"]},
    "verdicts": {"multi_kind": multi_kind, "conflicting": conflicting,
                 "conflict_rule": CONFLICT_RULE}}

blob = json.dumps(out, separators=(",", ":"))
print(blob)

n = len(out["objects"])
err = sys.stderr
if n:
    print("%d objects, %d bytes, %.0f per object" % (n, len(blob), len(blob) / n),
          file=err)
print("from %d finding(s), of which %d carried a resolvable reference"
      % (findings_total, hashed_rows), file=err)
if derived_rows:
    print("%d row(s) hashed at read time, producing %d distinct object(s)"
          % (derived_rows, len(derived_hashes)), file=err)
ex = out["excluded"]
if ex["total"]:
    print("%d finding(s) excluded: %d with no address, %d with no reference row"
          % (ex["total"], ex["no_address"], ex["no_reference_row"]), file=err)
    print("those are the hypothesis break, not a gap in the export", file=err)
repeats = [o for o in out["objects"] if o["seen"] > 1]
if repeats:
    same = sum(o["n"] - 1 for o in objs.values()
               if o["n"] > 1 and len(o["srcs"]) <= 1)
    norm = sum(o["n"] - 1 for o in objs.values()
               if o["n"] > 1 and len(o["srcs"]) > 1)
    print("%d object(s) seen more than once, %d repeat sighting(s); "
          "%d reference(s) collapsed to %d object(s)"
          % (len(repeats), sum(o["seen"] - 1 for o in repeats), hashed_rows, n),
          file=err)
    print("%d collapse(s) from the same address recorded again, %d from "
          "distinct addresses normalizing to one key" % (same, norm), file=err)
    if not norm:
        print("no object was reached by two different addresses, so this "
              "journal does not yet show normalization doing work beyond "
              "removing exact repeats", file=err)
if multi_kind:
    print("%d object(s) carry more than one verdict across their sightings, "
          "of which %d pair %s" % (multi_kind, conflicting, CONFLICT_RULE),
          file=err)
    print("a verdict describes an encounter rather than an object; "
          "multiplicity is not contradiction and only that pair is counted",
          file=err)
